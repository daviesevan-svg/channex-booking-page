{
  "name": "ib-scaffold",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "typecheck": "wrangler types && react-router typegen && tsc -b && node scripts/check-design-tokens.mjs",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types && node scripts/build-on-workers-ci.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
